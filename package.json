{
  "name": "payjay-trends",
  "version": "1.0.0",
  "description": "E-Commerce website for Payjay Trends with Express, Supabase/PostgreSQL, Paystack integration, SMTP email (forgot password with 6-digit code)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "init-db": "node init-db.js",
    "build:css": "tailwindcss -i ./public/input.css -o ./public/output.css --minify",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:report": "npx playwright show-report",
    "firebase:deploy": "firebase deploy --only hosting",
    "firebase:init": "firebase init"
  },
  "keywords": [
    "ecommerce",
    "fashion",
    "paystack",
    "express",
    "postgresql"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.6",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "autoprefixer": "^10.5.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19"
  }
}
